# Non-secret settings for the MR Emoji Board.
# Environment variables with the same name take precedence over this file.
# Tokens and secrets do not belong here: put them in secrets/ (see README).
MM_URL=https://mattermost.web.cern.ch
MM_CHANNEL_ID=wbbym949afy48rotc6um7n13tw
MM_CHANNEL_NAME=tools-reviews
# The board's OAuth 2.0 app (Mattermost > Integrations > OAuth 2.0 Applications).
# The redirect URL must match the app's callback URL exactly.
MM_OAUTH_CLIENT_ID=jzze3yjfufdx3fq7g9qzzyu5co
MM_OAUTH_REDIRECT_URL=http://localhost:8000/oauth/callback
GITLAB_URL=https://gitlab.cern.ch

# How far back the first harvest reads the channel (later ones read only new posts),
# and how long merged/closed MRs stay listed; open MRs stay until they finish.
HARVEST_DAYS=7
# How often to re-harvest.
REFRESH_MINUTES=5

# How long a merged MR stays in the board's "Merged" column.
MERGED_DAYS=7

# Where the Mattermost OAuth tokens and the MR database (board.db) are kept
# (relative to the repo, or absolute).
STATE_DIR=state
